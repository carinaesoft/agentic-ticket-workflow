# Copy to .env to override defaults. Every setting is optional; with none set, the
# service runs in fake LLM mode. Never commit a filled-in .env.

# Temporal (docker compose always points the containers at temporal:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tickets

# LLM provider: fake | openai | azure
LLM_PROVIDER=fake

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Unset: the v1 API. A dated version must be 2024-12-01-preview or later.
AZURE_OPENAI_API_VERSION=

# Agent limits (AGENT_MAX_TURNS: 1 to 8, so the turns fit in the 180 s decide timeout)
AGENT_MAX_TURNS=6
AGENT_MAX_PARSE_RETRIES=2

# Fake Helpdesk failure injection (0.0 - 1.0); HELPDESK_SEED makes failures reproducible
HELPDESK_FAILURE_RATE=0.2
HELPDESK_LOST_RESPONSE_RATE=0.1
HELPDESK_SEED=
# Optional file for the fake Helpdesk's idempotency store. Unset: kept in memory; docker
# compose points the worker at /srv/helpdesk/store.db, on a named volume.
HELPDESK_STORE_PATH=

# Logging
LOG_LEVEL=INFO
