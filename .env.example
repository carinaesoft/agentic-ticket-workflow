# Copy to .env to override defaults. Every setting is optional; with none set, the
# service runs in fake LLM mode. Never commit a filled-in .env.

# Temporal (docker compose always points the containers at temporal:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tickets

# LLM provider: fake | openai | azure
LLM_PROVIDER=fake

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Agent limits
AGENT_MAX_TURNS=6
AGENT_MAX_PARSE_RETRIES=2

# Fake Helpdesk failure injection (0.0 - 1.0); HELPDESK_SEED makes failures reproducible
HELPDESK_FAILURE_RATE=0.2
HELPDESK_LOST_RESPONSE_RATE=0.1
HELPDESK_SEED=

# Logging
LOG_LEVEL=INFO
